---
import Hero from "../components/Hero.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import type { InferEntrySchema } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  data: InferEntrySchema<"resume">;
}

const { data } = Astro.props;
---

<div class="container">
  <div class="header">
    <ul class="actions">
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </div>
  <Hero
    name={data.name}
    title={data.title}
    contact={data.contact}
    description={data.description}
  />
  <div class="body">
    <Skills {...data.skills} />
    {data.experience && <Experience {...data.experience} />}
    {data.education && <Education {...data.education} />}
  </div>
</div>

<style lang="scss">
  @use "../styles/utilities" as *;

  .container {
    --padding-top: var(--space-16);
    --padding-bottom: var(--space-128);
    --padding-x: var(--space-16);
    max-width: var(--layout-max-width);
    padding: var(--padding-top) var(--padding-x) var(--padding-bottom);
    display: flex;
    flex-direction: column;
    gap: var(--body-row-gap);
    font-size: var(--font-size-m);
  }

  .body {
    @include grid;
  }

  .header {
    display: flex;
    justify-content: flex-end;
  }

  .actions {
    display: flex;
  }

  @include from(mobile) {
    .container {
      --padding-x: var(--space-24);
    }
  }

  @include from(big-mobile) {
    .container {
      --padding-x: var(--space-48);
    }
  }

  @include print {
    .container {
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-48);
    }
    .header {
      display: none;
    }

    .body {
      grid-template-rows: repeat(var(--total-exp), auto) 1fr;
      align-items: flex-start;
      row-gap: 0;
    }
  }
</style>
