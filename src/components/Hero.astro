---
import { Image } from "astro:assets";
import ProfileImage from "../assets/images/profil.png";

interface Props {
  name: string;
  title: string;
  description: string;
  contact: {
    place: string;
    phone: string;
    email: string;
    links: Array<string>;
  };
}

const { name, title, description, contact } = Astro.props;
---

<section class="hero">
  <div class="hero__image-wrapper">
    <Image
      class="hero__image"
      src={ProfileImage}
      alt="Portrait of Loïc Hamet"
    />
  </div>
  <div class="hero__header">
    <h1 class="hero__name">{name}</h1>
    <h2 class="hero__title">{title}</h2>
  </div>
  <div class="contact">
    <ul class="contact__group">
      <li class="contact__item">{contact.place}</li>
      <li class="contact__item">{contact.phone}</li>
      <li class="contact__item">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </li>
    </ul>
    <ul class="contact__group">
      {contact.links.map((link) => (
        <li class="contact__item">
          <a href={link}>{link}</a>
        </li>
      ))}
    </ul>
  </div>
  <div class="divider"></div>
  <p class="hero__description">{description}</p>
</section>

<style lang="scss">
  @use "../styles/utilities" as *;

  .hero {
    --title-font-size: var(--font-size-xl);
    --padding-top: var(--space-64);
    --img-max-width: #{pxToRem(120)};
    --image-col-start: 1;
    --image-col-end: -1;
    --header-col-start: 1;
    --header-col-end: -1;
    --contact-col-start: 1;
    --contact-col-end: -1;
    --divider-col-start: 1;
    --divider-col-end: -1;
    --description-col-start: 1;
    --description-col-end: -1;
    --contact-group-span: 1;
    --image-row: unset;
    --contact-row: unset;

    padding-top: var(--padding-top);
    @include grid;
    row-gap: var(--space-24);

    &__image-wrapper {
      background-color: var(--color-light);
      border-radius: var(--radius-16);
      width: 100%;
      overflow: hidden;
      grid-column: var(--image-col-start) / var(--image-col-end);
      grid-row: var(--image-row);
      max-width: var(--img-max-width);
    }

    &__image {
      width: 100%;
      height: auto;
      mix-blend-mode: luminosity;
      filter: grayscale(1);
    }

    &__header {
      grid-column: var(--header-col-start) / var(--header-col-end);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      line-height: 1em;
      align-self: flex-end;
      font-size: var(--title-font-size);
    }

    &__name {
      font-weight: var(--font-weight-bold);
      white-space: nowrap;
    }

    &__title {
      font-weight: var(--font-weight-normal);
      white-space: nowrap;
    }

    &__description {
      grid-column: var(--description-col-start) / var(--description-col-end);
    }

    .contact {
      @include subgrid;
      grid-column: var(--contact-col-start) / var(--contact-col-end);
      align-content: flex-end;
      align-self: flex-end;
      row-gap: var(--space-8);
      grid-row: var(--contact-row);

      &__group {
        grid-column: span var(--contact-group-span);
      }
    }

    .divider {
      grid-column: var(--divider-col-start) / var(--divider-col-end);
      height: #{pxToRem(2)};
      background-color: var(--color-font);
    }

    @include from(mobile) {
      --img-max-width: auto;
      --image-col-end: span 3;
      --header-col-start: 1;
      --header-col-end: span 3;
      --contact-col-start: 6;
      --contact-group-span: 3;
      --description-col-end: span 7;
    }

    @include from(desktop) {
      --title-font-size: var(--font-size-xxl);
      --image-col-start: var(--grid-col-2-start);
      --image-col-end: span 2;
      --header-col-start: var(--grid-col-2-start);
      --header-col-end: span 5;
      --contact-col-start: calc(var(--grid-col-2-start) + 5);
      --contact-col-end: -1;
      --divider-col-start: var(--grid-col-2-start);
      --divider-col-end: -1;
      --description-col-start: var(--grid-col-2-start);
      --description-col-end: span 5;
      --contact-group-span: 2;
    }
  }

  @include print {
    .hero {
      --padding-top: 0;
      --title-font-size: var(--font-size-xl);
      --image-col-start: 11;
      --image-col-end: end;
      --header-col-start: 1;
      --header-col-end: span 7;
      --contact-col-start: 8;
      --contact-col-end: span 3;
      --divider-col-start: 1;
      --divider-col-end: span 7;
      --description-col-start: 1;
      --description-col-end: span 7;
      --contact-row: 1 / span 3;
      --image-row: 1 / span 3;
      --contact-group-span: 3;
      --img-max-width: auto;

      grid-column: 1 / -1;

      &__image-wrapper {
        background-color: transparent;
        position: relative;
        align-self: stretch;
        width: 100%;
        justify-self: stretch;
      }

      &__image {
        position: absolute;
        object-fit: cover;
        width: 100%;
        height: 100%;
        mix-blend-mode: unset;
        filter: unset;
      }
    }
  }
</style>
