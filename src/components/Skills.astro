---
interface Props {
  title: string;
  list: Array<{
    title: string;
    items: string[];
  }>;
}

const { title, list } = Astro.props;
---

<section class="skills">
  <h2 class="skills__title">{title}</h2>
  <dl class="skills__list">
    {list.map(({ title, items }) => (
      <div class="skills__part">
        <div class="skills__part-inner">
          <dt>{title}</dt>
          <div>
            {items?.map((value) => (
              <dd>{value}</dd>
            ))}
          </div>
        </div>
      </div>
    ))}
  </dl>
</section>

<style lang="scss">
  @use "../styles/utilities" as *;

  .skills {
    display: grid;
    grid-template-columns: var(--grid-template-columns);
    column-gap: var(--grid-col-gap);
    row-gap: var(--grid-row-gap);
    column-gap: var(--grid-col-gap);

    &__title {
      grid-column: span var(--grid-col-1-span);
      font-size: var(--font-size-l);
      font-weight: var(--font-weight-bold);
    }

    &__list {
      grid-column: span 8;
      columns: 4;
    }

    &__part {
      break-inside: avoid-column;
      margin-block-end: var(--space-24);
      position: relative;
      display: flex;
      gap: var(--space-8);
      align-items: stretch;

      &-inner {
        display: flex;
        gap: var(--space-4);
        flex-direction: column;
      }

      dt {
        font-weight: var(--font-weight-bold);
      }

      dd {
        font-size: var(--font-size-s);
      }

      &:before {
        content: "";
        display: block;
        width: #{pxToRem(2)};
        background-color: var(--color-font);
      }
    }

    &__part-inner {
    }
  }
</style>
