---
interface Props {
  title: string;
  list: Array<{
    title: string;
    items: string[];
  }>;
}

const { title, list } = Astro.props;
---

<section class="skills">
  <h2 class="skills__title">{title}</h2>
  <dl class="skills__list">
    {list.map(({ title, items }) => (
      <div class="skills__part">
        <dt>{title}</dt>
        <div>
          {items?.map((value) => (
            <dd>{value}</dd>
          ))}
        </div>
      </div>
    ))}
  </dl>
</section>
