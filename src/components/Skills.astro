---
interface Props {
  title: string;
  list: Array<{
    title: string;
    items: string[];
  }>;
}

const { title, list } = Astro.props;
---

<section class="skills">
  <h2 class="skills__title">{title}</h2>
  <dl class="skills__list">
    {list.map(({ title, items }) => (
      <div class="skill">
        <div class="skill__inner">
          <dt class="skill__title">{title}</dt>
          <div class="skill__body">
            {items?.map((value) => (
              <dd class="skill__item">{value}</dd>
            ))}
          </div>
        </div>
      </div>
    ))}
  </dl>
</section>

<style lang="scss">
  @use "../styles/utilities" as *;

  .skills {
    --list-grid-end: -1;
    --columns: 1;

    @include grid;
    margin-block-end: var(--body-row-gap);
    grid-column: 1 / -1;

    &__title {
      @include first-col;
      font-size: var(--font-size-l);
      font-weight: var(--font-weight-bold);
      margin-block-end: var(--title-end);
    }

    &__list {
      @include second-col;
      columns: var(--columns);
      column-gap: var(--body-col-gap);
      grid-column-end: var(--list-grid-end);
    }
  }

  .skill {
    margin-block-end: var(--space-24);
    position: relative;
    display: flex;
    gap: var(--space-8);
    align-items: stretch;

    &__inner {
      display: flex;
      gap: var(--space-4);
      flex-direction: column;
    }

    &__title {
      font-weight: var(--font-weight-bold);
    }

    &__body {
      display: flex;
      flex-direction: column;
    }

    &__item {
      font-size: var(--font-size-s);
    }

    &:before {
      content: "";
      display: block;
      width: #{pxToRem(2)};
      background-color: var(--color-font);
    }
  }

  @include from(small-mobile) {
    .skills {
      --columns: 3;
    }
  }

  @include from(mobile) {
    .skills {
      --list-grid-end: span 12;
      --columns: 4;
    }
  }

  @include from(desktop) {
    .skills {
      --list-grid-end: span 8;
      --columns: 4;
      row-gap: 0;
    }
  }

  @include print {
    .skills {
      --grid-columns: 1;
      --columns: 1;
      --list-grid-end: 1;

      grid-column: 1 / span 3;
      display: block;
      break-inside: avoid;
      page-break-inside: avoid;
      grid-row: 1 / span 3;

      &__title {
        &:after {
          content: "";
          display: block;
          height: #{pxToRem(2)};
          background: var(--color-font);
          margin: var(--space-8) 0 var(--space-16);
        }
      }

      &__list {
        --body-row-gap: var(--space-32);
      }
    }

    .skill {
      &__title {
        text-transform: uppercase;
        font-size: var(--font-size-s);
      }

      &__body {
        flex-direction: row;
        flex-wrap: wrap;
        gap: var(--space-4);
      }

      &__item {
        font-size: var(--font-size-m);

        &:not(:last-child) {
          &:after {
            content: ",";
          }
        }
      }

      &:before {
        display: none;
      }

      &:not(:last-child) {
        margin-block-end: var(--space-16);
      }
    }
  }
</style>
