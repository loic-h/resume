---
interface Props {
  title: string;
  items: Array<{
    company: string;
    position: string;
    place: string;
    time: {
      start: string;
      end: string;
    };
    description?: string;
    responsibilities: Array<{
      title: string;
      description?: string;
    }>;
  }>;
}

const { title, items } = Astro.props;
---

<Fragment>
  <h2 class="experience-title">{title}</h2>
  {items.map(
    ({ company, position, place, time, description, responsibilities }) => (
      <div class="experience">
        <h4 class="experience__company">{company}</h4>
        <h3 class="experience__position">{position}</h3>
        <div class="experience__divider" />
        <ul class="experience__info">
          <li class="experience__place">{place}</li>
          <li class="experience__time">
            <span>{time.start}</span>
            <span>{time.end}</span>
          </li>
        </ul>
        {description && <p class="experience__description">{description}</p>}

        {responsibilities && responsibilities.length > 0 && (
          <ul class="experience__responsibilities">
            {responsibilities.map(({ title, description }) => (
              <li class="responsibility">
                <h5 class="responsibility__title">{title}</h5>
                {description && (
                  <p class="responsibility__description">{description}</p>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    ),
  )}
</Fragment>

<style lang="scss">
  @use "../styles/utilities" as *;

  .experience-title {
    @include first-col;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    margin-block-end: var(--title-end);
  }

  .experience {
    --gap-company-end: var(--space-4);
    --gap-divider-start: var(--space-16);
    --gap-divider-end: var(--space-16);
    --gap-position-end: var(--space-8);
    --gap-info-end: 0;
    --gap-description-end: var(--space-24);
    --company-col-start: 1;
    --company-col-end: -1;
    --company-row: 1;
    --position-col-start: 1;
    --position-col-end: -1;
    --position-row: 2;
    --info-col-start: 1;
    --info-col-end: -1;
    --info-row: 3;
    --description-col-start: 1;
    --description-col-end: -1;
    --description-row: 5;
    --responsibilities-col-start: 1;
    --responsibilities-col-end: -1;
    --responsibilities-row: 6;
    --divider-col-start: 1;
    --divider-col-end: -1;
    --divider-row: 4;
    --content-max-width: #{pxToRem(600)};

    @include subgrid;
    align-items: start;
    @include second-col;
    grid-template-rows: repeat(4, auto) 1fr;
    margin-block-end: var(--exp-row-gap);

    &:last-of-type {
      margin-block-end: var(--body-row-gap);
    }

    &__company {
      font-size: var(--font-size-m);
      font-weight: var(--font-weight-bold);
      grid-column: var(--company-col-start) / var(--company-col-end);
      grid-row: var(--company-row);
      margin-block-end: var(--gap-company-end);
    }

    &__position {
      font-size: var(--font-size-l);
      font-weight: var(--font-weight-bold);
      grid-column: var(--position-col-start) / var(--position-col-end);
      grid-row: var(--position-row);
      margin-block-end: var(--gap-position-end);
    }

    &__info {
      grid-column: var(--info-col-start) / var(--info-col-end);
      grid-row: var(--info-row);
      margin-block-end: var(--gap-info-end);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    &__time {
      display: flex;
      gap: var(--space-4);

      & span {
        display: flex;
        gap: var(--space-4);

        &:first-child:after {
          content: "→";
        }
      }
    }

    &__description {
      grid-column: var(--description-col-start) / var(--description-col-end);
      grid-row: var(--description-row);
      margin-block-end: var(--gap-description-end);
      max-width: var(--content-max-width);
    }

    &__responsibilities {
      grid-column: var(--responsibilities-col-start) /
        var(--responsibilities-col-end);
      grid-row: var(--responsibilities-row);
      // grid-row: 4 / -1;
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      max-width: var(--content-max-width);
    }

    &__divider {
      height: #{pxToRem(2)};
      grid-column: var(--divider-col-start) / var(--divider-col-end);
      background-color: var(--color-font);
      grid-row: var(--divider-row);
      margin-block-end: var(--gap-divider-end);
      margin-block-start: var(--gap-divider-start);
    }
  }

  .responsibility {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    &__title {
      font-size: var(--font-size-m);
      font-weight: var(--font-weight-bold);
    }
  }

  @include from(big-mobile) {
    .experience {
      --divider-row: 3;
      --info-row: 4;
      --description-row: 5;
      --responsibilities-row: 4 / span 2;
      --gap-info-end: var(--space-24);
      --info-col-end: 4;
      --description-col-end: 4;
      --responsibilities-col-start: 4;
      --gap-description-end: 0;
    }
  }

  @include from(desktop) {
    .experience {
      row-gap: 0;
    }
  }

  @include print {
    .experience-title {
      grid-column: 4 / -1;
      margin-block-end: var(--space-8);
    }

    .experience {
      --gap-company-end: var(--space-4);
      --gap-divider: var(--space-4);
      --gap-position-end: var(--space-4);
      --gap-info-end: var(--space-16);
      --gap-description-end: var(--space-16);
      --content-max-width: auto;
      --gap-divider-start: 0;

      grid-column: 4 / -1;
      display: flex;
      flex-direction: column;
      align-self: flex-start;

      &:not(:last-child) {
        margin-block-end: var(--space-32);
      }

      &__company {
        order: 2;
        text-transform: uppercase;
        font-size: var(--font-size-s);
      }

      &__info {
        order: 4;
        flex-direction: row;
        float: left;
      }

      &__position {
        order: 3;
      }

      &__description {
        order: 5;
      }

      &__responsibilities {
        order: 6;
      }

      &__divider {
        width: 100%;
        order: 1;
      }
    }

    .responsibility {
      display: block;

      &__title {
        float: left;
        margin-right: var(--space-4);

        &:after {
          content: ":";
        }
      }
    }
  }
</style>
