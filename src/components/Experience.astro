---
interface Props {
  title: string;
  items: Array<{
    company: string;
    position: string;
    place: string;
    time: {
      start: string;
      end: string;
    };
    description?: string;
    responsibilities: Array<{
      title: string;
      description?: string;
    }>;
  }>;
}

const { title, items } = Astro.props;
---

<section class="experience">
  <h2 class="experience__title">{title}</h2>
  <div class="experience__items">
    {items.map(
      ({ company, position, place, time, description, responsibilities }) => (
        <div class="experience-item">
          <h4 class="experience-item__company">{company}</h4>
          <h3 class="experience-item__position">{position}</h3>
          <ul class="experience-item__info">
            <li class="experience-item__place">{place}</li>
            <li class="experience-item__time">
              <span>{time.start}</span>
              <span>{time.end}</span>
            </li>
          </ul>
          {description && (
            <p class="experience-item__description">{description}</p>
          )}

          {responsibilities && responsibilities.length > 0 && (
            <div class="experience-item__responsibilities">
              <h4 class="sr-only">Responsibilities</h4>
              <ul>
                {responsibilities.map(({ title, description }) => (
                  <li class="responsibility">
                    <h5 class="responsibility__title">{title}</h5>
                    {description && (
                      <p class="responsibility__description">{description}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ),
    )}
  </div>
</section>
