---
interface Props {
  title: string;
  items: Array<{
    institute: string;
    title: string;
    place: string;
    time: string;
  }>;
}

const { title, items } = Astro.props;
---

<section class="education">
  <h2 class="education__title">{title}</h2>
  <ul class="education__items">
    {items.map(({ title, institute, place, time }) => (
      <li class="education-item">
        <p class="education-item__institute">{institute}</p>
        <h3 class="education-item__title" set:html={title} />
        <p class="education-item__info">
          <span class="education-item__place">{place}</span>
          <span class="education-item__time">{time}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  @use "../styles/utilities" as *;

  .education {
    --list-col-end: -1;
    @include subgrid;
    align-items: baseline;
    grid-column: 1 / -1;

    &__title {
      @include first-col;
      font-size: var(--font-size-l);
      font-weight: var(--font-weight-bold);
      margin-block-end: var(--title-end);
    }

    &__items {
      @include second-col;
      display: flex;
      flex-direction: column;
      row-gap: var(--space-24);
      grid-column-end: var(--list-col-end);
    }
  }

  .education-item {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    &__title {
      font-size: var(--font-size-m);
      font-weight: var(--font-weight-bold);
    }

    &__institute {
      font-weight: var(--font-weight-bold);
    }

    &__info {
      --gap: var(--space-8);

      display: flex;
      gap: var(--gap);

      & :first-child {
        display: flex;
        gap: var(--gap);

        &:after {
          content: "–";
        }
      }
    }
  }

  @include from(big-mobile) {
    .education {
      --list-col-end: span 6;
    }
  }

  @include from(desktop) {
    .education {
      --list-col-end: span 4;
    }
  }

  @include print {
    .education {
      --grid-columns: 1;
      --body-row-gap: var(--space-8);

      grid-column: 1 / span 3;
      grid-row: 4 / -1;

      &__items {
        row-gap: var(--space-8);
      }
    }

    .education-item {
      &:before {
        content: "";
        height: #{pxToRem(2)};
        width: 100%;
        background-color: var(--color-font);
        margin-block-end: var(--space-8);
      }

      &__institute {
        text-transform: uppercase;
        font-size: var(--font-size-s);
      }
    }
  }
</style>
