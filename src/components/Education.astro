---
interface Props {
  title: string;
  items: Array<{
    institute: string;
    title: string;
    place: string;
    time: string;
  }>;
}

const { title, items } = Astro.props;
---

<section class="education">
  <h2 class="education__title">{title}</h2>
  <ul class="education__items">
    {items.map(({ title, institute, place, time }) => (
      <li class="education-item">
        <p class="education-item__institute">{institute}</p>
        <h3 class="education-item__title" set:html={title} />
        <p class="education-item__info">
          <span class="education-item__place">{place}</span>
          <span class="education-item__time">{time}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  @use "../styles/utilities" as *;

  .education {
    display: grid;
    grid-template-columns: var(--grid-template-columns);
    column-gap: var(--grid-col-gap);
    row-gap: var(--grid-row-gap);
    column-gap: var(--grid-col-gap);

    &__title {
      grid-column: span var(--grid-col-1-span);
      font-size: var(--font-size-l);
      font-weight: var(--font-weight-bold);
    }

    &__items {
      grid-column: var(--grid-col-2-start) / -1;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-24);
    }
  }

  .education-item {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    &__title {
      font-size: var(--font-size-m);
      font-weight: var(--font-weight-bold);
    }

    &__institute {
      font-weight: var(--font-weight-bold);
    }

    &__info {
      --gap: var(--space-8);

      display: flex;
      gap: var(--gap);

      & :first-child {
        display: flex;
        gap: var(--gap);

        &:after {
          content: "–";
        }
      }
    }
  }
</style>
